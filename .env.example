# MooSic Environment Configuration

# ==============================================================================
# 🌐 PUBLIC CLIENT CONFIGURATION (Embutido no Bundle Web & APK)
# ==============================================================================

VITE_APP_NAME=MooSic
VITE_APP_ENV=development

# Seletor de Provedores Ativos (mock | real)
VITE_MUSIC_PROVIDER=mock
VITE_METADATA_PROVIDER=mock
VITE_LYRICS_PROVIDER=mock
VITE_AUDIO_PROVIDER=mock

# MusicBrainz Public API Configuration
VITE_MUSICBRAINZ_API_URL=https://musicbrainz.org/ws/2
# ATENÇÃO: Preencher com um email válido de contato antes da Fase 4 (Exigência da API MusicBrainz para o header User-Agent)
VITE_MUSICBRAINZ_CONTACT_EMAIL=

# Jamendo Public Client Configuration
VITE_JAMENDO_CLIENT_ID=

# ==============================================================================
# 🔒 PRIVATE SERVER SECRETS (NUNCA incluir no cliente Web ou APK!)
# Estas variáveis pertencem exclusivamente a ambientes server-side / Edge Functions.
# ==============================================================================

# SUPABASE_SERVICE_ROLE_KEY=
# PRIVATE_AUDIO_PROVIDER_SECRET=
# PRIVATE_LYRICS_API_KEY=
